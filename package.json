{
  "name": "llm-evalboard-root",
  "version": "0.1.0",
  "private": true,
  "description": "Statistically Honest LLM Evaluation Framework and Dashboard",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "hello-eval": "pnpm --filter @evalboard/cli build && node ./packages/cli/dist/index.js hello",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:migrate": "pnpm --filter @evalboard/db migrate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": ["biome check --write"]
  }
}
